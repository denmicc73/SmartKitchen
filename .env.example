# Copia este archivo a ".env" y rellena tus propios valores.
# NUNCA subas el archivo ".env" real a git.
# Forma facil en Windows:
#   powershell -ExecutionPolicy Bypass -File scripts/generate-prod-env.ps1

# Base de datos MySQL
DB_ROOT_PASS=pega_aqui_una_contrasena_larga
DB_NAME=smartkitchen
DB_USER=smartkitchen
DB_PASS=pega_aqui_otra_contrasena_larga

# Usuario administrador inicial de la app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pega_aqui_una_contrasena_larga

# Opcional: solo si quieres recetas generadas por IA.
ANTHROPIC_API_KEY=
