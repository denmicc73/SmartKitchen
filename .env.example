# Copia este archivo a ".env" y rellena tus propios valores.
# NUNCA subas el archivo ".env" real a git.
# Forma facil:
#   Linux / VPS : ./scripts/generate-prod-env.sh  <IP_O_DOMINIO_DEL_VPS>
#   Windows     : powershell -ExecutionPolicy Bypass -File scripts/generate-prod-env.ps1
#
# Este .env es para el despliegue manual con docker-compose. Con Coolify las
# variables se ponen en la UI de la aplicacion (ver README, seccion Coolify);
# alli DB_ROOT_PASS no hace falta y DB_HOST/USER/PASS salen del recurso MySQL.

# Base de datos MySQL
DB_ROOT_PASS=pega_aqui_una_contrasena_larga
DB_NAME=smartkitchen
DB_USER=smartkitchen
DB_PASS=pega_aqui_otra_contrasena_larga

# Usuario administrador inicial de la app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pega_aqui_una_contrasena_larga
# Correo personal del admin: permite recuperar su contrasena desde
# "He olvidado mi contrasena". Si se deja vacio, el admin no puede usar
# la recuperacion por correo (tendra que cambiarla desde Ajustes).
ADMIN_EMAIL=

# URL publica desde la que se accede a la app. Se usa para construir los
# enlaces de los correos de confirmacion y de reseteo. En un VPS sin dominio
# es  http://LA_IP_DEL_VPS:8080
BASE_URL=http://localhost:8080

# Solo perfil dev: carpeta donde se guardan la base de datos H2 y las imagenes
# subidas. Por defecto ~/.smart-kitchen (ruta absoluta, no depende de desde
# donde se lance la app). Cambiala solo si quieres mover esos datos.
#SMARTKITCHEN_HOME=

# Envio de correo (confirmacion de cuenta y "olvide mi contrasena").
# En DESARROLLO es mas comodo poner estas credenciales en un fichero aparte,
# fuera del repo:  ~/.smart-kitchen/smtp.properties  (ver smtp.properties.example).
# La app solo envia de verdad si hay SMTP_USER y SMTP_PASS; si no, escribe el
# enlace en el log. El host por defecto ya es Gmail (smtp.gmail.com:587).
# Para Gmail: SMTP_PASS debe ser una "contrasena de aplicacion" de Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Alternativa: envio por API HTTP de Brevo (brevo.com, 300 correos/dia gratis).
# Util si el proveedor bloquea el SMTP saliente. Si se rellena, tiene prioridad
# sobre SMTP. El remitente (MAIL_FROM) debe estar verificado en la cuenta Brevo.
BREVO_API_KEY=
# Remitente. Con Gmail debe ser tu propia direccion; por defecto usa SMTP_USER.
MAIL_FROM=

# IA (Anthropic): escanear productos con la cámara y sugerencias de recetas.
# En desarrollo es más cómodo ponerla en  ~/.smart-kitchen/ia.properties
# (ver ia.properties.example). Sin clave, esas funciones se desactivan.
ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-4-6
